---
import Icon from './Icon.astro';
import { pageUrl } from '../lib/posts';

interface Props {
  current: number;
  total: number;
  /** URL of page 1, e.g. "/" or "/category/ai/". */
  base: string;
  /** Appended to the page-1 link (the home page jumps past its full-screen hero). */
  firstAnchor?: string;
}
const { current, total, base, firstAnchor = '' } = Astro.props;

// First, last and the neighbours of the current page; gaps collapse to "…".
const pages: (number | null)[] = [];
for (let p = 1; p <= total; p++) {
  if (p === 1 || p === total || Math.abs(p - current) <= 1) pages.push(p);
  else if (pages.at(-1) !== null) pages.push(null);
}
const href = (p: number) => (p === 1 ? base + firstAnchor : pageUrl(base, p));
---

{total > 1 && (
  <nav class="pagination" aria-label="分页">
    {current > 1 && (
      <a class="page-step" href={href(current - 1)} rel="prev"><span class="page-prev"><Icon name="chevron" size={14} /></span>上一页</a>
    )}
    {pages.map((p) => p === null
      ? <span class="page-gap" aria-hidden="true">…</span>
      : p === current
        ? <span class="page-num current" aria-current="page">{p}</span>
        : <a class="page-num" href={href(p)} aria-label={`第 ${p} 页`}>{p}</a>)}
    {current < total && (
      <a class="page-step" href={href(current + 1)} rel="next">下一页<Icon name="chevron" size={14} /></a>
    )}
  </nav>
)}
