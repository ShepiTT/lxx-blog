---
// Loads the on-page editor after a previous login or an explicit request to edit.
// Regular visitors download nothing extra: the editor module is a separate chunk.
---

<div class="toast" role="status" aria-live="polite" data-toast hidden></div>

<script>
  let hint: string | null = null;
  try { hint = localStorage.getItem('admin-hint'); } catch {}
  const requestedEditing = new URLSearchParams(location.search).get('edit') === '1';
  if (hint || requestedEditing) import('../lib/editor/editor').then((m) => m.init());
</script>
