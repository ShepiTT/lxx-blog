---
import Icon from './Icon.astro';
import { postUrl, tagUrl, categoryUrl, categoryName, isoDate, readingMinutes, type Post } from '../lib/posts';

interface Props {
  post: Post;
  eager?: boolean;
  pinned?: boolean;
}
const { post, eager = false, pinned = false } = Astro.props;
const { title, description, date, category, tags, cover } = post.data;
const url = postUrl(post);
// Without a cover the card shows a date block instead of a stock image.
const day = String(date.getUTCDate()).padStart(2, '0');
const yearMonth = `${date.getUTCFullYear()}.${String(date.getUTCMonth() + 1).padStart(2, '0')}`;
const weekday = `周${'日一二三四五六'[date.getUTCDay()]}`;
---

<article class:list={['post-card', { 'no-cover': !cover }]} data-cat={category} data-post-id={post.id} data-post-title={title}>
  {cover ? (
    <a class="post-cover" href={url} tabindex="-1" aria-hidden="true">
      <img src={cover} alt="" width="640" height="400" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </a>
  ) : (
    <a class="post-date" href={url} tabindex="-1" aria-hidden="true">
      <span class="post-date-day">{day}</span>
      <span class="post-date-month">{yearMonth}</span>
      <span class="post-date-week">{weekday}</span>
    </a>
  )}
  <div class="post-info">
    <h3 class="post-title"><a href={url}>{title}</a></h3>
    <div class="post-meta">
      {pinned && <span class="post-pin"><Icon name="up" size={14} />置顶</span>}
      <span><Icon name="calendar" size={14} /> 发表于 <time datetime={isoDate(date)}>{isoDate(date)}</time></span>
      <span class="sep">|</span>
      <span><Icon name="folder" size={14} /> <a href={categoryUrl(category)}>{categoryName(category)}</a></span>
      {tags.length > 0 && (
        <>
          <span class="sep">|</span>
          <span><Icon name="tag" size={14} /> {tags.map((tag, i) => <>{i > 0 && <span class="dot">•</span>}<a href={tagUrl(tag)}>{tag}</a></>)}</span>
        </>
      )}
    </div>
    <p class="post-excerpt">{description}</p>
    <span class="post-read"><Icon name="clock" size={14} /> 阅读约 {readingMinutes(post.body)} 分钟</span>
  </div>
</article>
