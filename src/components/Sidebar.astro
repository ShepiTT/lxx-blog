---
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import { SITE, SOCIALS, CATEGORIES } from '../site.config';
import { getPosts, tagCounts, postUrl, categoryUrl, tagUrl, isoDate } from '../lib/posts';

interface Props {
  toc?: { depth: number; slug: string; text: string }[];
}
const { toc } = Astro.props;

const posts = await getPosts();
const tags = tagCounts(posts);
const recent = posts.slice(0, 5);
const github = SOCIALS.find((s) => s.icon === 'github');
const lastUpdate = posts[0]?.data.date;
const tagColors = ['#49b1f5', '#ff7242', '#f6a23b', '#3fc380', '#a07de8', '#ff6b9b', '#20b2aa', '#e05a5a'];
const maxCount = Math.max(1, ...tags.map((t) => t.count));
---

<aside class="aside">
  <section class="card author-card">
    <div class="author-banner" style={`--banner-image: url('${SITE.heroImage}')`} data-hero-image></div>
    <img class="author-avatar" src={SITE.avatar} width="110" height="110" alt={`${SITE.author} 的头像`} data-edit="site.avatar" />
    <h2 class="author-name" data-edit="site.author">{SITE.author}</h2>
    <p class="author-motto" data-edit="site.motto">{SITE.motto}</p>
    <div class="author-stats">
      <a href="/archive/"><span>文章</span><strong>{posts.length}</strong></a>
      <a href="/tags/"><span>标签</span><strong>{tags.length}</strong></a>
      <a href={categoryUrl(CATEGORIES[0].id)}><span>分类</span><strong>{CATEGORIES.length}</strong></a>
    </div>
    {github && <a class="follow-button" href={github.href}><Icon name="github" size={16} /> 关注我</a>}
    <SocialLinks />
  </section>

  {toc && toc.length > 0 ? (
    <div class="aside-sticky">
      <section class="card">
        <h2 class="card-heading"><Icon name="list" /> 目录</h2>
        <ol class="toc" data-toc>
          {toc.map((h) => <li class={`toc-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </section>
      <section class="card">
        <h2 class="card-heading"><Icon name="history" /> 最新文章</h2>
        <ul class="recent-list">
          {recent.map((p) => (
            <li>
              <a class="recent-thumb" href={postUrl(p)} tabindex="-1" aria-hidden="true"><img src={p.data.cover} alt="" width="64" height="64" loading="lazy" /></a>
              <div><a href={postUrl(p)}>{p.data.title}</a><time datetime={isoDate(p.data.date)}>{isoDate(p.data.date)}</time></div>
            </li>
          ))}
        </ul>
      </section>
    </div>
  ) : (
    <>
      <section class="card">
        <h2 class="card-heading"><Icon name="bell" /> 公告</h2>
        <p class="notice-text" data-edit="site.notice">{SITE.notice}</p>
      </section>
      <div class="aside-sticky">
        <section class="card">
          <h2 class="card-heading"><Icon name="history" /> 最新文章</h2>
          <ul class="recent-list">
            {recent.map((p) => (
              <li>
                <a class="recent-thumb" href={postUrl(p)} tabindex="-1" aria-hidden="true"><img src={p.data.cover} alt="" width="64" height="64" loading="lazy" /></a>
                <div><a href={postUrl(p)}>{p.data.title}</a><time datetime={isoDate(p.data.date)}>{isoDate(p.data.date)}</time></div>
              </li>
            ))}
          </ul>
        </section>
        <section class="card">
          <h2 class="card-heading"><Icon name="folder" /> 分类</h2>
          <ul class="category-list">
            {CATEGORIES.map((c) => (
              <li><a href={categoryUrl(c.id)}><span>{c.name}</span><span class="count">{posts.filter((p) => p.data.category === c.id).length}</span></a></li>
            ))}
          </ul>
        </section>
        <section class="card">
          <h2 class="card-heading"><Icon name="tag" /> 标签</h2>
          <div class="aside-tags">
            {tags.map(({ tag, count }, i) => (
              <a href={tagUrl(tag)} style={`color:${tagColors[i % tagColors.length]};font-size:${Math.round(14 + ((count - 1) / Math.max(1, maxCount - 1)) * 8)}px`}>{tag}</a>
            ))}
          </div>
        </section>
        <section class="card">
          <h2 class="card-heading"><Icon name="chart" /> 网站资讯</h2>
          <ul class="site-info" data-start={SITE.startDate} data-updated={lastUpdate?.toISOString()}>
            <li><span>文章数目</span><strong>{posts.length}</strong></li>
            <li><span>已运行时间</span><strong data-run-days>-- 天</strong></li>
            <li><span>本站访客数</span><strong><span data-bsz="busuanzi_value_site_uv">--</span></strong></li>
            <li><span>本站总访问量</span><strong><span data-bsz="busuanzi_value_site_pv">--</span></strong></li>
            <li><span>最后更新时间</span><strong data-updated-ago>--</strong></li>
          </ul>
        </section>
      </div>
    </>
  )}
</aside>

<script>
  const info = document.querySelector<HTMLElement>('.site-info');
  if (info) {
    const day = 86_400_000;
    const start = new Date(`${info.dataset.start}T00:00:00+08:00`).getTime();
    const days = Math.max(0, Math.floor((Date.now() - start) / day));
    info.querySelector('[data-run-days]')!.textContent = `${days} 天`;
    if (info.dataset.updated) {
      const ago = Math.floor((Date.now() - new Date(info.dataset.updated).getTime()) / day);
      info.querySelector('[data-updated-ago]')!.textContent = ago <= 0 ? '今天' : `${ago} 天前`;
    }

    // The visitor counter fills the footer's ids; mirror those numbers here.
    info.querySelectorAll<HTMLElement>('[data-bsz]').forEach((target) => {
      const source = document.getElementById(target.dataset.bsz!);
      if (!source) return;
      const sync = () => { target.textContent = source.textContent; };
      new MutationObserver(sync).observe(source, { childList: true, characterData: true, subtree: true });
      sync();
    });
  }

  // Highlight the heading currently being read in the table of contents.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
  if (links.length) {
    const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) => a.removeAttribute('aria-current'));
        byId.get(entry.target.id)?.setAttribute('aria-current', 'true');
      }
    }, { rootMargin: '-70px 0px -70% 0px' });
    document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach((h) => observer.observe(h));
  }
</script>
