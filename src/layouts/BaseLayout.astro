---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import Rightside from '../components/Rightside.astro';
import Petals from '../components/Petals.astro';
import EditMode from '../components/EditMode.astro';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description = SITE.description, image = '/og.jpg', type = 'website' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} - AI 应用开发 · 日常 · 感悟`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={SITE.avatar} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Resolve the theme before first paint so dark mode never flashes white. -->
    <script is:inline>
      (() => {
        // 每次打开网站按北京时间决定：19:00 到次日 7:00 是夜间模式，其余时间白天。
        // 这次浏览里手动切换过就沿用（只存在本标签页，关掉后重新按时间判断）。
        let picked = null;
        try { picked = sessionStorage.getItem('theme'); } catch {}
        const hour = (new Date().getUTCHours() + 8) % 24; // 北京时间 UTC+8，没有夏令时
        document.documentElement.dataset.theme = picked || (hour >= 19 || hour < 7 ? 'dark' : 'light');
      })();
    </script>
    <!-- 访问统计：vercount（第三方服务，兼容不蒜子），数字会填进页脚、侧边栏和文章阅读量。
         它按域名计数，本地预览会显示全世界 localhost 的总数，所以本地不加载，只显示「本地不统计」。 -->
    <script is:inline>
      (() => {
        const host = location.hostname;
        const local = host === 'localhost' || host === '127.0.0.1' || host === '[::1]' || host.endsWith('.localhost');
        if (!local) {
          const s = document.createElement('script');
          s.src = 'https://events.vercount.one/js';
          document.head.append(s);
          return;
        }
        addEventListener('DOMContentLoaded', () => {
          ['busuanzi_value_site_pv', 'busuanzi_value_site_uv', 'busuanzi_value_page_pv'].forEach((id) => {
            const el = document.getElementById(id);
            if (el) el.textContent = '本地不统计';
          });
          document.querySelectorAll('[data-stats-line]').forEach((el) => { el.hidden = true; });
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <Header />
    <slot name="banner" />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Rightside />
    <Petals />
    <Search />
    <EditMode />
  </body>
</html>
