---
import '../styles/global.css';
import '../styles/admin.css';
import { SITE } from '../site.config';
import { isLoggedIn } from '../lib/admin/auth';

interface Props {
  title: string;
}
const { title } = Astro.props;
const loggedIn = isLoggedIn(Astro.cookies);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | {SITE.title} 后台</title>
    <link rel="icon" href={SITE.avatar} />
    <script is:inline>
      (() => {
        // 每次打开网站按北京时间决定：19:00 到次日 7:00 是夜间模式，其余时间白天。
        // 这次浏览里手动切换过就沿用（只存在本标签页，关掉后重新按时间判断）。
        let picked = null;
        try { picked = sessionStorage.getItem('theme'); } catch {}
        const hour = (new Date().getUTCHours() + 8) % 24; // 北京时间 UTC+8，没有夏令时
        document.documentElement.dataset.theme = picked || (hour >= 19 || hour < 7 ? 'dark' : 'light');
      })();
    </script>
    {loggedIn && <script is:inline>
      try { localStorage.setItem('admin-hint', '1'); } catch {}
    </script>}
  </head>
  <body class="admin">
    <slot />
    <div class="toast" role="status" aria-live="polite" data-toast hidden></div>
  </body>
</html>
