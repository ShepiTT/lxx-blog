---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import IntroCard from '../components/IntroCard.astro';
import ProjectList from '../components/ProjectList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Icon from '../components/Icon.astro';
import { SITE, CATEGORIES } from '../site.config';
import { getPosts, categoryUrl } from '../lib/posts';

const posts = await getPosts();
const countOf = (id: string) => posts.filter((p) => p.data.category === id).length;
const description = SITE.intro?.role ? `${SITE.author}：${SITE.intro.role}` : `关于 ${SITE.author}`;
---

<BaseLayout title="关于我" description={description}>
  <Banner slot="banner" title="关于我" />
  <div class="layout layout-single">
    <div class="layout-main">
      {SITE.intro ? <IntroCard /> : <div class="card empty-state">还没有填写个人介绍。</div>}

      <ProjectList />

      <section class="card" aria-labelledby="topics-title">
        <h2 id="topics-title" class="card-heading"><Icon name="file" /> 我在博客写什么</h2>
        <div class="topic-grid">
          {CATEGORIES.map((c) => (
            <a class="topic-card" href={categoryUrl(c.id)} data-cat={c.id}>
              <strong>{c.name}</strong>
              <span>{c.description}</span>
              <em>{countOf(c.id)} 篇文章 <Icon name="chevron" size={14} /></em>
            </a>
          ))}
        </div>
      </section>

      <section class="card about-contact" aria-labelledby="contact-title">
        <h2 id="contact-title" class="card-heading"><Icon name="mail" /> 找到我</h2>
        <SocialLinks labels />
      </section>
    </div>
  </div>
</BaseLayout>
