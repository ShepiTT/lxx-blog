---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Icon from '../components/Icon.astro';
import { SITE, CATEGORIES } from '../site.config';
import { getPosts, categoryUrl } from '../lib/posts';
import { Content as AboutContent } from '../data/about.md';

const posts = await getPosts();
const countOf = (id: string) => posts.filter((p) => p.data.category === id).length;
---

<BaseLayout title="关于我" description={`关于 ${SITE.author}：关注 AI 应用开发的程序员，在这里记录技术、日常与感悟。`}>
  <Banner slot="banner" title="关于我" />
  <div class="layout layout-single">
    <div class="layout-main">
      <div class="card about-card">
        <div class="about-head">
          <img class="author-avatar" src={SITE.avatar} width="120" height="120" alt={`${SITE.author} 的头像`} data-edit="site.avatar" />
          <h2>你好，我是 <span data-edit="site.author">{SITE.author}</span> 👋</h2>
          <p data-edit="site.motto">{SITE.motto}</p>
          <SocialLinks />
        </div>

        <div class="prose" data-edit="about" data-edit-label="编辑介绍">
          <AboutContent />
        </div>

        <div class="prose"><h2>我在写什么</h2></div>
        <div class="topic-grid">
          {CATEGORIES.map((c) => (
            <a class="topic-card" href={categoryUrl(c.id)} data-cat={c.id}>
              <strong>{c.name}</strong>
              <span>{c.description}</span>
              <em>{countOf(c.id)} 篇文章 <Icon name="chevron" size={14} /></em>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
