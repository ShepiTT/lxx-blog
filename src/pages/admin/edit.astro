---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isItemType, isValidId, itemPath, parseMarkdown, toDateString } from '../../lib/admin/content';
import { getStorage, StorageError } from '../../lib/admin/storage';
import { CATEGORIES } from '../../site.config';

export const prerender = false;

const typeParam = Astro.url.searchParams.get('type');
const type = isItemType(typeParam) ? typeParam : 'blog';
const idParam = Astro.url.searchParams.get('id');
const isNew = !idParam;

let error = '';
let sha = '';
let data: Record<string, unknown> = {};
let body = '';

if (!isNew) {
  if (!isValidId(idParam)) return Astro.redirect('/admin/');
  try {
    const file = await getStorage().read(itemPath(type, idParam));
    if (!file) return Astro.redirect('/admin/');
    sha = file.sha;
    ({ data, body } = parseMarkdown(file.content));
  } catch (err) {
    error = err instanceof StorageError ? err.message : '读取失败';
  }
}

// Beijing time for display and for new items.
const beijing = (d: Date) => new Date(d.getTime() + 8 * 3600_000).toISOString();
const now = beijing(new Date());
const blogDate = isNew ? now.slice(0, 10) : toDateString(data.date).slice(0, 10);
const talkDate = isNew ? now.slice(0, 16) : (() => {
  const parsed = Date.parse(toDateString(data.date));
  return Number.isNaN(parsed) ? now.slice(0, 16) : beijing(new Date(parsed)).slice(0, 16);
})();
const list = (v: unknown) => (Array.isArray(v) ? v.map(String) : []);

const initial = {
  type,
  isNew,
  id: idParam ?? '',
  sha,
  images: list(data.images),
};
const heading = `${isNew ? (type === 'blog' ? '写文章' : '发说说') : type === 'blog' ? '编辑文章' : '编辑说说'}`;
---

<AdminLayout title={heading}>
  <header class="admin-bar">
    <a class="admin-btn ghost" href="/admin/">← 返回</a>
    <span class="admin-brand">{heading}</span>
    <label class="edit-draft" hidden={type !== 'blog'}><input type="checkbox" name="draft" form="editor" checked={Boolean(data.draft)} /> 存为草稿</label>
    <button class="admin-btn primary" type="submit" form="editor" data-save>发布</button>
  </header>

  <main class="admin-main">
    {error && <p class="form-error">{error}</p>}
    <form id="editor" class="edit-form" data-editor data-initial={JSON.stringify(initial)}>
      {type === 'blog' ? (
        <section class="admin-panel edit-meta">
          <label class="span-2">标题<input name="title" value={String(data.title ?? '')} required maxlength="80" /></label>
          <label>
            文章地址{isNew ? '（英文小写、数字、短横线）' : '（不可修改）'}
            <input name="id" value={idParam ?? ''} pattern="[a-z0-9][a-z0-9-]*" placeholder="例如 my-first-post" required readonly={!isNew} />
          </label>
          <label>日期<input name="date" type="date" value={blogDate} required /></label>
          <label>分类
            <select name="category">
              {CATEGORIES.map((c) => <option value={c.id} selected={data.category === c.id}>{c.name}</option>)}
            </select>
          </label>
          <label>标签（用逗号分隔）<input name="tags" value={list(data.tags).join(', ')} placeholder="RAG, LLM" /></label>
          <label class="span-2">摘要（显示在文章卡片上）<textarea name="description" rows="2" required maxlength="200">{String(data.description ?? '')}</textarea></label>
          <div class="span-2 cover-field">
            <span>封面图</span>
            <div class="cover-row">
              <img data-cover-preview src={String(data.cover ?? '') || undefined} alt="" hidden={!data.cover} />
              <input name="cover" value={String(data.cover ?? '')} placeholder="/uploads/... 或 /covers/..." />
              <label class="admin-btn ghost file-btn">上传封面<input type="file" accept="image/*" data-cover-upload hidden /></label>
            </div>
          </div>
        </section>
      ) : (
        <section class="admin-panel edit-meta">
          <label>时间（北京时间）<input name="date" type="datetime-local" value={talkDate} required /></label>
          <label>标签（用逗号分隔）<input name="tags" value={list(data.tags).join(', ')} placeholder="生活, AI" /></label>
          <div class="span-2 talk-images-field">
            <span>配图</span>
            <div class="talk-image-list" data-talk-images></div>
            <label class="admin-btn ghost file-btn">添加图片<input type="file" accept="image/*" multiple data-talk-upload hidden /></label>
          </div>
        </section>
      )}

      <section class="admin-panel edit-body">
        <div class="edit-toolbar">
          <span>正文（Markdown）</span>
          <label class="admin-btn ghost file-btn">插入图片<input type="file" accept="image/*" data-insert-image hidden /></label>
        </div>
        <div class="edit-panes">
          <textarea name="body" data-body spellcheck="false" placeholder={type === 'blog' ? '## 小标题\n\n正文……' : '想说点什么……'}>{body}</textarea>
          <div class="edit-preview prose" data-preview></div>
        </div>
      </section>
    </form>
  </main>
</AdminLayout>

<script>
  import { marked } from 'marked';
  import { toast } from '../../lib/admin/toast';
  import { uploadImage } from '../../lib/admin/upload-client';

  const form = document.querySelector<HTMLFormElement>('[data-editor]')!;
  const initial = JSON.parse(form.dataset.initial!) as { type: 'blog' | 'talks'; isNew: boolean; id: string; sha: string; images: string[] };
  const bodyInput = form.querySelector<HTMLTextAreaElement>('[data-body]')!;
  const preview = form.querySelector<HTMLElement>('[data-preview]')!;
  const saveBtn = document.querySelector<HTMLButtonElement>('[data-save]')!;
  let dirty = false;

  // Images uploaded in this session are not on the live site until the next deploy,
  // so preview them from the local file instead.
  const localPreviews = new Map<string, string>();
  const previewSrc = (url: string) => localPreviews.get(url) ?? url;

  const renderPreview = () => {
    preview.innerHTML = marked.parse(bodyInput.value || '*（还没有内容）*', { async: false }) as string;
    preview.querySelectorAll('img').forEach((img) => { img.src = previewSrc(img.getAttribute('src') ?? ''); });
  };
  let previewTimer: ReturnType<typeof setTimeout>;
  bodyInput.addEventListener('input', () => { clearTimeout(previewTimer); previewTimer = setTimeout(renderPreview, 150); });
  renderPreview();
  form.addEventListener('input', () => { dirty = true; });
  addEventListener('beforeunload', (e) => { if (dirty) e.preventDefault(); });

  async function upload(file: File): Promise<string | null> {
    toast('图片上传中…');
    try {
      const { url, preview } = await uploadImage(file);
      localPreviews.set(url, preview);
      toast('图片已上传');
      dirty = true;
      return url;
    } catch (err) {
      toast((err as Error).message || '上传失败', true);
      return null;
    }
  }

  // Insert an image into the Markdown body at the cursor.
  form.querySelector<HTMLInputElement>('[data-insert-image]')!.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    input.value = '';
    if (!file) return;
    const url = await upload(file);
    if (!url) return;
    const { selectionStart: s, selectionEnd: end, value } = bodyInput;
    const snippet = `\n![](${url})\n`;
    bodyInput.value = value.slice(0, s) + snippet + value.slice(end);
    bodyInput.selectionStart = bodyInput.selectionEnd = s + snippet.length;
    renderPreview();
  });

  // Blog cover
  const coverInput = form.querySelector<HTMLInputElement>('input[name="cover"]');
  const coverPreview = form.querySelector<HTMLImageElement>('[data-cover-preview]');
  const showCover = () => {
    if (!coverInput || !coverPreview) return;
    coverPreview.hidden = !coverInput.value;
    if (coverInput.value) coverPreview.src = previewSrc(coverInput.value);
  };
  coverInput?.addEventListener('change', showCover);
  form.querySelector<HTMLInputElement>('[data-cover-upload]')?.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    input.value = '';
    if (!file || !coverInput) return;
    const url = await upload(file);
    if (url) { coverInput.value = url; showCover(); }
  });

  // Talk images
  const images = [...initial.images];
  const imageList = form.querySelector<HTMLElement>('[data-talk-images]');
  const renderImages = () => {
    if (!imageList) return;
    imageList.innerHTML = '';
    images.forEach((src, i) => {
      const item = document.createElement('div');
      item.className = 'talk-image-item';
      const img = document.createElement('img');
      img.src = previewSrc(src);
      img.alt = '';
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.textContent = '×';
      remove.setAttribute('aria-label', '移除这张图');
      remove.addEventListener('click', () => { images.splice(i, 1); dirty = true; renderImages(); });
      item.append(img, remove);
      imageList.append(item);
    });
  };
  renderImages();
  form.querySelector<HTMLInputElement>('[data-talk-upload]')?.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const files = [...(input.files ?? [])];
    input.value = '';
    for (const file of files) {
      const url = await upload(file);
      if (url) { images.push(url); renderImages(); }
    }
  });

  // Save
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const tags = String(fd.get('tags') ?? '').split(/[,，]/).map((t) => t.trim()).filter(Boolean);
    let id = initial.id;
    let data: Record<string, unknown>;
    if (initial.type === 'blog') {
      if (initial.isNew) id = String(fd.get('id') ?? '').trim();
      data = {
        title: fd.get('title'), description: fd.get('description'), date: fd.get('date'),
        category: fd.get('category'), tags, cover: fd.get('cover'), draft: fd.get('draft') === 'on',
      };
    } else {
      const local = String(fd.get('date'));
      if (initial.isNew) id = `${local.replace('T', '-').replace(':', '')}${new Date().getSeconds().toString().padStart(2, '0')}`;
      data = { date: `${local}:00+08:00`, images, tags };
    }

    saveBtn.disabled = true;
    saveBtn.textContent = '发布中…';
    try {
      const res = await fetch('/api/admin/item', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: initial.type, id, isNew: initial.isNew, sha: initial.sha, data, body: bodyInput.value }),
      });
      const out = await res.json();
      if (!res.ok) throw new Error(out.error);
      dirty = false;
      toast(out.mode === 'github' ? '已发布！网站约 1 分钟后更新' : '已保存');
      setTimeout(() => { location.href = '/admin/'; }, 1200);
    } catch (err) {
      toast((err as Error).message || '发布失败', true);
      saveBtn.disabled = false;
      saveBtn.textContent = '发布';
    }
  });
</script>
